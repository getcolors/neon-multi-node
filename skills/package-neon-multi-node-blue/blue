"""Thin launcher for package-neon-multi-node-blue.

This file is both the skill payload and the repository entry point —
blue/blue in the repository is a symlink to it. It deliberately holds no
logic of its own: validation, the graph and the steps all live in the
package-neon-multi-node-blue library, where the test suite reaches them. A copied
payload is the one place in this project where code cannot be tested, so
nothing that can live elsewhere should live here.
"""

import os
import subprocess
import sys

UNPINNED_ERROR = """\
this launcher carries no neon-multi-node pin.
It has not been stamped by `bb pin`, which cannot run until the neon-multi-node
repository has been pushed.
Point it at a checkout meanwhile: NEON_MULTI_NODE_LIB_ROOT=/path/to/neon-multi-node (the repository root)
(or run through the repository project: cd neon-multi-node/blue && uv run python -m package_neon_multi_node_blue ...)
"""


def _lib_root_project(root: str) -> str:
    """The uv project inside a NEON_MULTI_NODE_LIB_ROOT checkout: the repository
    root, whose blue/ directory holds the implementation."""
    if os.path.isfile(os.path.join(root, "pyproject.toml")):
        return root
    return os.path.join(root, "blue")


def main() -> None:
    root = os.environ.get("NEON_MULTI_NODE_LIB_ROOT")
    if root:
        result = subprocess.run(
            ["uv", "run", "--project", _lib_root_project(root),
             "python", "-m", "package_neon_multi_node_blue", *sys.argv[1:]])
        raise SystemExit(result.returncode)
    try:
        from package_neon_multi_node_blue import exec  # resolvable only once pinned
    except ImportError:
        sys.stderr.write(UNPINNED_ERROR)
        raise SystemExit(2)
    exec()


if __name__ == "__main__":
    main()
